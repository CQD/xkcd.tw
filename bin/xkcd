#!/usr/bin/env php
<?php

if ($argc <= 1) {
    fputs(STDERR, "使用方法：
 - xkcd \033[1;30mstrip id [meta|img]\033[m
");
    exit;
}

$id = (int) $argv[1];
$action = $argv[2] ?? 'meta';
$meta = file_get_contents("https://xkcd.com/{$id}/info.0.json");

if (!$meta) {
    fputs(STDERR, "撈不到 xkcd:{$id} 的資料 /__\\\n");
    exit;
}
$meta = json_decode($meta, true);

if ($meta['year'] && $meta['day'] && $meta['month']) {
    $meta['date'] = "{$meta['year']}-{$meta['month']}-{$meta['day']}";
    unset($meta['year']);
    unset($meta['month']);
    unset($meta['day']);
}

echo json_encode($meta, JSON_PRETTY_PRINT|JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES), "\n";


if ('img' === $action) {
    if (!isset($meta['img'])) {
        fputs(STDERR, "沒有 img 沒辦法拉圖檔!!\n");
    } else {
        $candidates = [];
        if ($id >= 1063) {
            $candidates[] = preg_replace('/\.(png|jpg)$/', '_2x.$1', $meta['img']);
        }
        $candidates[] = $meta['img'];

        $saved = false;
        foreach (array_unique($candidates) as $imgUrl) {
            $fileName = $id . "_" . basename($imgUrl);
            if (download($imgUrl, $fileName)) {
                fputs(STDERR, "圖檔已存為 {$fileName}\n");
                $saved = true;
                break;
            }
            fputs(STDERR, "{$imgUrl} 下載失敗\n");
        }

        if (!$saved) {
            exit(1);
        }
    }
}

////////////////////////////////////////

function download(string $url, string $fileName): bool
{
    // 失敗的時候要讓外面知道錯誤，不要默默吞掉
    $cmd = sprintf('curl -fsSL %s -o %s', escapeshellarg($url), escapeshellarg($fileName));
    exec($cmd, $output, $code);
    if (0 !== $code) {
        @unlink($fileName);
        return false;
    }
    return true;
}
